# GitHub rejects ordinary Git blobs larger than 100 MiB; store spectra via LFS.
data/foriceberg/**/spec_files.hdf5 filter=lfs diff=lfs merge=lfs -text

# Local environments and generated run artifacts do not belong in release archives.
scratch/ export-ignore
.venv/ export-ignore
script/foriceberg/results/ export-ignore
script/formula_prediction/results/ export-ignore
.env export-ignore
